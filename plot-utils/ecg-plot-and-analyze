def parse_start_time_from_filename(filename):
	"""
	Parse start time from filename format: "2025-11-04--17:55PM" or "2025-11-04--17:55AM"
	Filename is in 24h format, so AM/PM suffix is ignored.
	Returns datetime.time object or None if not found/parseable.
	"""
	# Pattern: YYYY-MM-DD--HH:MM[AM|PM]
	pattern = r'(\d{4})-(\d{2})-(\d{2})--(\d{1,2}):(\d{2})(AM|PM)?'
	match = re.search(pattern, filename)
	
	if match:
		year, month, day, hour, minute, ampm = match.groups()
		hour = int(hour)
		minute = int(minute)
		
		# Filename is in 24h format, so ignore AM/PM
		return time(hour=hour, minute=minute, second=0)
	
	return None

def parse_time_arg(time_str):
	"""
	Parse time argument which can be:
	- Integer (seconds from midnight)
	- "HH:MM:SS"
	- "HH:MM" (becomes HH:MM:00)
	Returns datetime.time object.
	"""
	# Try integer first
	try:
		seconds = int(time_str)
		if seconds < 0:
			raise ValueError("Seconds cannot be negative")
		hours = seconds // 3600
		minutes = (seconds % 3600) // 60
		secs = seconds % 60
		if hours >= 24:
			raise ValueError("Hours exceed 24")
		return time(hour=hours, minute=minutes, second=secs)
	except ValueError as e:
		if "invalid literal" not in str(e):
			raise  # Re-raise if it's our custom error
	
	# Try HH:MM:SS or HH:MM format
	if ':' in time_str:
		parts = time_str.split(':')
		if len(parts) == 2:
			# HH:MM
			return time(hour=int(parts[0]), minute=int(parts[1]), second=0)
		elif len(parts) == 3:
			# HH:MM:SS
			return time(hour=int(parts[0]), minute=int(parts[1]), second=int(parts[2]))
	
	raise ValueError(f"Invalid time format: {time_str}. Use HH:MM:SS, HH:MM, or integer seconds")

def time_to_seconds(t):
	"""Convert datetime.time to seconds from midnight"""
	return t.hour * 3600 + t.minute * 60 + t.second

def proclog(fn=None):
	millis = []  # millis
	vals = []
	f = open(args.file)
	cnt=0
	for line in f:
		cnt += 1
		if ' ' not in line:
			print(f"ERROR: Line {cnt} missing space separator. Bad data at line {cnt}")
			next
		ms, val = line.strip().split(" ")
		ms = float(ms)
		val = float(val)
		if val < 3 or val == 1024: pass
		else:
			# print(ms, "val:", val)
			vals.append(val)
			millis.append(ms)
	return np.array(millis), np.array(vals)

def calc_sampling_rate(timedata, time_units=None):
	# Calculate average Hz of given times.
	#  Example time_units:
	#   time_units = .001 (or 1e-3) for millisecond data
	#   time_units = .000001 (or 1e-6) for uS data
	# 1. First we generate an array of the deltas (differences in time)
	aa = [timedata[i+1] - float(timedata[i]) for i in range(len(timedata)-1)]
	#print([a for a in enumerate(aa)])
	avg = sum(aa)/len(aa)
	# 2. Filter outliers
	#  (These exist because of jumps in the sampling data that we
	#  got when removing invalid sensor data, like a lot of 2s and
	#  1024s we got from moving around or disconnecting the electrodes)
	aa = [x for x in aa if (abs(x-avg)/avg) < 1.5]
	# 3. Recalculate avg
	avg = sum(aa)/len(aa)
	sam_per_sec = (1/time_units) / avg
	return sam_per_sec

def butter_highpass(cutoff, fs, order=5):
    nyq = 0.5 * fs
    normal_cutoff = cutoff / nyq
    b, a = signal.butter(order, normal_cutoff, btype='high', analog=False)
    return b, a

def butter_highpass_filter(data, cutoff, fs, order=5):
    b, a = butter_highpass(cutoff, fs, order=order)
    y = signal.filtfilt(b, a, data)
    return y

def butter_lowpass(cutoff, fs, order=5):
    return butter(order, cutoff, fs=fs, btype='low', analog=False)

def butter_lowpass_filter(data, cutoff, fs, order=5):
    b, a = butter_lowpass(cutoff, fs, order=order)
    y = lfilter(b, a, data)
    return y

def notch(data, f, fs=None, quality=30):
	notch_num, notch_den = iirnotch(f, quality, fs=fs)
	return lfilter(notch_num, notch_den, data)

def bandstop(data, lowcut, highcut, fs=None, order=2):
	nyq = 0.5 * fs
	low = lowcut / nyq
	high = highcut / nyq

	i, u = butter(order, [low, high], btype='bandstop')
	y = lfilter(i, u, data)
	return y

def detect_r_peaks(data, fs, min_distance_ms=300):
	"""
	Detect R-peaks (QRS complexes) in ECG data.
	min_distance_ms: minimum time between peaks (prevents double-detection)
	"""
	# Convert min distance from ms to samples
	min_distance_samples = int((min_distance_ms / 1000.0) * fs)
	
	# Use robust peak detection
	# Height threshold: use a percentage of the signal range
	signal_range = np.max(data) - np.min(data)
	height_threshold = np.min(data) + signal_range * 0.3  # 30% above minimum
	
	peaks, properties = find_peaks(data, 
	                                height=height_threshold,
	                                distance=min_distance_samples,
	                                prominence=signal_range * 0.15)
	
	return peaks


def extract_cycles(data, ms, r_peaks, fs, pre_ms=200, post_ms=200):
	"""
	Extract individual heartbeat cycles from R-peak to R-peak (variable duration).
	pre_ms: milliseconds before R-peak to include (for P-wave capture)
	post_ms: milliseconds after next R-peak to include (for visual context)
	
	Each cycle runs from (R-peak - pre_ms) to (next R-peak + post_ms), giving variable-length
	cycles that reflect actual heart rate variability, plus context beyond the cycle.
	"""
	pre_samples = int((pre_ms / 1000.0) * fs)
	post_samples = int((post_ms / 1000.0) * fs)
	
	cycles = []
	cycle_times = []
	cycle_indices = []
	
	# Extract from R-peak to R-peak (skip last peak since it has no "next")
	for i in range(len(r_peaks) - 1):
		current_r = r_peaks[i]
		next_r = r_peaks[i + 1]
		
		start_idx = current_r - pre_samples
		end_idx = next_r + post_samples  # Add context past next R-peak
		
		# Make sure we're within bounds
		if start_idx >= 0 and end_idx < len(data):
			cycle_data = data[start_idx:end_idx]
			# Time relative to R-peak (current_r is at time = pre_ms in the cycle)
			cycle_time = ms[start_idx:end_idx] - ms[current_r]
			cycles.append(cycle_data)
			cycle_times.append(cycle_time)
			cycle_indices.append(i)
	
	return cycles, cycle_times, cycle_indices


def reject_artifacts(cycles, cycle_times, r_peaks, ms, fs):
	"""
	Reject physiologically impossible or artifact-corrupted cycles.
	Returns indices of good cycles and rejection reasons for bad ones.
	"""
	if len(cycles) == 0:
		return [], {}
	
	good_indices = []
	rejection_reasons = {}
	
	# Calculate RR intervals (beat-to-beat timing)
	rr_intervals = []
	if len(r_peaks) > 1:
		for i in range(len(r_peaks) - 1):
			rr_interval = ms[r_peaks[i+1]] - ms[r_peaks[i]]
			rr_intervals.append(rr_interval)
	
	# Calculate median amplitude for comparison
	amplitudes = [np.max(cycle) - np.min(cycle) for cycle in cycles]
	median_amplitude = np.median(amplitudes)
	
	for i, cycle in enumerate(cycles):
		reasons = []
		
		# Check 1: RR interval (if not first or last beat)
		if i < len(rr_intervals):
			rr = rr_intervals[i]
			if rr < 300 or rr > 2300:  # 30-230 bpm range
				reasons.append(f"RR interval {rr:.0f}ms out of range (300-2300ms)")
		
		# Check 2: Amplitude
		amplitude = np.max(cycle) - np.min(cycle)
		if amplitude < median_amplitude * 0.2:
			reasons.append(f"Amplitude too low ({amplitude:.1f} < {median_amplitude*0.2:.1f})")
		elif amplitude > median_amplitude * 5.0:
			reasons.append(f"Amplitude too high ({amplitude:.1f} > {median_amplitude*5:.1f})")
		
		# Check 3: Baseline stability (check for massive shifts)
		# Look at first and last 50ms (baseline sections)
		baseline_samples = int(0.05 * fs)  # 50ms
		if len(cycle) > 2 * baseline_samples:
			baseline_start = np.mean(cycle[:baseline_samples])
			baseline_end = np.mean(cycle[-baseline_samples:])
			baseline_shift = abs(baseline_end - baseline_start)
			if baseline_shift > amplitude * 0.5:  # More than 50% of signal amplitude
				reasons.append(f"Excessive baseline shift ({baseline_shift:.1f})")
		
		# Check 4: NaN or infinite values
		if np.any(np.isnan(cycle)) or np.any(np.isinf(cycle)):
			reasons.append("Contains NaN or Inf values")
		
		if len(reasons) == 0:
			good_indices.append(i)
		else:
			rejection_reasons[i] = reasons
	
	return good_indices, rejection_reasons

def average_cycles(cycles, cycle_times, r_peak_times_ms=None, 
                   focus_percentage=None, focus_time_s=None, max_cycles=50,
                   target_length_percentile=85, sample_rate=None):
	"""
	Average multiple heartbeat cycles with intelligent cycle selection and time-stretching.
	
	Parameters:
	-----------
	cycles : list of arrays
		Individual heartbeat cycles
	cycle_times : list of arrays
		Time arrays for each cycle (relative to R-peak)
	r_peak_times_ms : array, optional
		Absolute timestamps (ms) of each R-peak for focus selection
	focus_percentage : float, optional (0-100)
		Focus on cycles near this percentage of recording. Overrides focus_time_s.
	focus_time_s : float, optional
		Focus on cycles near this time (seconds from start). Default: None (use all)
	max_cycles : int
		Maximum number of cycles to include in average
	target_length_percentile : float
		Percentile of cycle lengths to use as target (default 85 for high resolution)
	sample_rate : float
		Sampling rate in Hz (needed for time array reconstruction)
	
	Returns:
	--------
	averaged_cycle : array
		Averaged and resampled cycle
	averaged_time : array
		Time array for averaged cycle
	selected_indices : list
		Indices of cycles that were selected and averaged
	resampled_cycles : list of arrays
		Individual cycles after resampling (for plotting)
	resampled_time : array
		Common time array for resampled cycles
	"""
	if len(cycles) == 0:
		return None, None, [], [], None
	
	# Step 1: Select cycles based on focus parameters
	selected_indices = list(range(len(cycles)))
	
	if r_peak_times_ms is not None and (focus_percentage is not None or focus_time_s is not None):
		# Calculate focus time
		if focus_percentage is not None:
			# Convert percentage to absolute time
			recording_duration = r_peak_times_ms[-1] - r_peak_times_ms[0]
			focus_time_ms = r_peak_times_ms[0] + (focus_percentage / 100.0) * recording_duration
		else:
			# Use provided focus time (convert seconds to ms)
			focus_time_ms = r_peak_times_ms[0] + (focus_time_s * 1000.0)
		
		# Calculate distances from focus time
		distances = np.abs(r_peak_times_ms - focus_time_ms)
		
		# Sort by distance and take closest cycles (up to max_cycles)
		sorted_indices = np.argsort(distances)
		selected_indices = sorted_indices[:max_cycles].tolist()
		selected_indices.sort()  # Keep chronological order
		
		print(f"   Focus selection: Using {len(selected_indices)} cycles near {focus_time_ms/1000.0:.1f}s")
	elif len(cycles) > max_cycles:
		# No focus specified, just use first max_cycles
		selected_indices = list(range(max_cycles))
		print(f"   Using first {max_cycles} cycles (no focus specified)")
	
	selected_cycles = [cycles[i] for i in selected_indices]
	selected_cycle_times = [cycle_times[i] for i in selected_indices]
	
	# Step 2: Determine target length (use percentile for good resolution)
	cycle_lengths = [len(c) for c in selected_cycles]
	target_length = int(np.percentile(cycle_lengths, target_length_percentile))
	
	# Also calculate target DURATION at the same percentile
	cycle_durations_ms = [ct[-1] - ct[0] for ct in selected_cycle_times]
	target_duration_ms = np.percentile(cycle_durations_ms, target_length_percentile)
	
	print(f"   Target length: {target_length} samples ({target_length_percentile}th percentile)")
	print(f"   Target duration: {target_duration_ms:.1f}ms")
	print(f"   Cycle length range: {min(cycle_lengths)} - {max(cycle_lengths)} samples")
	print(f"   Cycle duration range: {min(cycle_durations_ms):.1f} - {max(cycle_durations_ms):.1f}ms")
	
	# Step 3: Resample all cycles to target length
	resampled_cycles = []
	for cycle in selected_cycles:
		if len(cycle) == target_length:
			resampled_cycles.append(cycle)
		else:
			# Use scipy's resample for high-quality FFT-based resampling
			resampled = resample(cycle, target_length)
			resampled_cycles.append(resampled)
	
	# Step 4: Average the resampled cycles
	resampled_array = np.array(resampled_cycles)
	averaged_cycle = np.mean(resampled_array, axis=0)
	
	# Step 5: Reconstruct time array for averaged cycle
	# Use the target_duration that matches our target_length_percentile
	# Get the starting offset from first cycle (typically negative for pre-R-peak data)
	time_start_offset = selected_cycle_times[0][0]
	averaged_time = np.linspace(time_start_offset, 
	                            time_start_offset + target_duration_ms,
	                            target_length)
	
	return averaged_cycle, averaged_time, selected_indices, resampled_cycles, averaged_time

def detect_pqrst_features(cycle, cycle_time, fs):
	"""
	Detect P, Q, R, S, T waves in an averaged cycle.
	Returns dictionary of feature locations (in samples and ms).
	"""
	features = {}
	
	# R-peak: Find actual maximum near time=0 (within ±20ms window)
	# Don't just use closest sample to time=0, find the true peak!
	search_window_ms = 20
	r_search_mask = (cycle_time >= -search_window_ms) & (cycle_time <= search_window_ms)
	r_search_indices = np.where(r_search_mask)[0]
	if len(r_search_indices) > 0:
		r_idx = r_search_indices[np.argmax(cycle[r_search_indices])]
	else:
		# Fallback to closest to zero if search window fails
		r_idx = np.argmin(np.abs(cycle_time))
	features['R'] = {'idx': r_idx, 'time_ms': cycle_time[r_idx], 'amplitude': cycle[r_idx]}
	
	# Q wave: minimum before R (within 50ms)
	search_samples = int(0.05 * fs)
	q_search_start = max(0, r_idx - search_samples)
	q_idx = q_search_start + np.argmin(cycle[q_search_start:r_idx])
	features['Q'] = {'idx': q_idx, 'time_ms': cycle_time[q_idx], 'amplitude': cycle[q_idx]}
	
	# S wave: minimum after R (within 50ms)
	s_search_end = min(len(cycle), r_idx + search_samples)
	s_idx = r_idx + np.argmin(cycle[r_idx:s_search_end])
	features['S'] = {'idx': s_idx, 'time_ms': cycle_time[s_idx], 'amplitude': cycle[s_idx]}
	
	# T wave: maximum after S (search 150-400ms after R)
	t_search_start = r_idx + int(0.15 * fs)
	t_search_end = min(len(cycle), r_idx + int(0.4 * fs))
	if t_search_start < len(cycle) and t_search_end > t_search_start:
		t_idx = t_search_start + np.argmax(cycle[t_search_start:t_search_end])
		features['T'] = {'idx': t_idx, 'time_ms': cycle_time[t_idx], 'amplitude': cycle[t_idx]}
	
	# P wave: small peak before Q (search 50-200ms before R)
	p_search_start = max(0, r_idx - int(0.2 * fs))
	p_search_end = max(0, r_idx - int(0.05 * fs))
	if p_search_end > p_search_start:
		# P wave is subtle, look for local maximum
		p_region = cycle[p_search_start:p_search_end]
		if len(p_region) > 0:
			p_idx = p_search_start + np.argmax(p_region)
			features['P'] = {'idx': p_idx, 'time_ms': cycle_time[p_idx], 'amplitude': cycle[p_idx]}
	
	return features

def calculate_intervals(features, rr_interval_ms=None):
	"""
	Calculate ECG intervals from detected features.
	"""
	intervals = {}
	
	if rr_interval_ms:
		intervals['RR_interval_ms'] = rr_interval_ms
		intervals['Heart_rate_bpm'] = 60000 / rr_interval_ms
	
	if 'P' in features and 'R' in features:
		intervals['PR_interval_ms'] = features['R']['time_ms'] - features['P']['time_ms']
	
	if 'Q' in features and 'S' in features:
		intervals['QRS_duration_ms'] = features['S']['time_ms'] - features['Q']['time_ms']
	
	if 'Q' in features and 'T' in features:
		intervals['QT_interval_ms'] = features['T']['time_ms'] - features['Q']['time_ms']
		# Bazett's formula for QTc (corrected QT)
		if rr_interval_ms:
			intervals['QTc_ms'] = intervals['QT_interval_ms'] / np.sqrt(rr_interval_ms / 1000.0)
	
	return intervals

def plot_averaged_cycles(cycles, cycle_times, averaged_cycle, averaged_time, 
                        selected_indices, resampled_cycles=None, resampled_time=None,
                        plot_selected=True, plot_resampled=True):
	"""
	Plot individual cycles (transparent) and averaged cycle (bold).
	
	Parameters:
	-----------
	cycles : list of arrays
		All original cycles
	cycle_times : list of arrays
		Time arrays for original cycles
	averaged_cycle : array
		The averaged cycle
	averaged_time : array
		Time array for averaged cycle
	selected_indices : list
		Indices of cycles that were selected for averaging
	resampled_cycles : list of arrays, optional
		Resampled cycles (aligned for averaging)
	resampled_time : array, optional
		Common time array for resampled cycles
	plot_selected : bool
		Whether to plot original selected cycles
	plot_resampled : bool
		Whether to plot resampled cycles
	"""
	fig, ax = plt.subplots(figsize=(12, 6))
	
	# Plot original selected cycles first (gray, transparent)
	if plot_selected:
		for i in selected_indices:
			ax.plot(cycle_times[i], cycles[i], 
			        color=(0.7, 0.7, 0.7), alpha=0.3, linewidth=0.5)
	
	# Plot resampled cycles on top (light blue, transparent)
	if plot_resampled and resampled_cycles is not None and resampled_time is not None:
		for resampled_cycle in resampled_cycles:
			ax.plot(resampled_time, resampled_cycle,
			        color=(0.9, 0.9, 1.0), alpha=0.4, linewidth=0.5)
	
	# Plot averaged cycle (bold green)
	ax.plot(averaged_time, averaged_cycle, 
	        color=(0, 0.5, 0), linewidth=3, label='Averaged Cycle')
	
	ax.axvline(x=0, color='red', linestyle='--', alpha=0.5, label='R-peak')
	ax.set_xlabel('Time from R-peak (ms)')
	ax.set_ylabel('Amplitude')
	ax.set_title(f'Averaged Heartbeat Cycle (n={len(selected_indices)} cycles)')
	ax.legend()
	ax.grid(True, alpha=0.3)
	
	return fig


def plot_analysis(averaged_cycle, averaged_time, features, intervals):
	"""
	Plot annotated ECG with detected features and intervals.
	"""
	fig, ax = plt.subplots(figsize=(14, 8))
	
	# Plot the averaged cycle
	ax.plot(averaged_time, averaged_cycle, 
	        color='black', linewidth=2, label='Averaged ECG')
	
	# Mark detected features
	colors = {'P': 'blue', 'Q': 'green', 'R': 'red', 'S': 'orange', 'T': 'purple'}
	for wave_name, feature in features.items():
		color = colors.get(wave_name, 'gray')
		ax.plot(feature['time_ms'], feature['amplitude'], 
		        'o', color=color, markersize=10, label=f'{wave_name} wave')
		ax.annotate(wave_name, 
		           xy=(feature['time_ms'], feature['amplitude']),
		           xytext=(0, 15), textcoords='offset points',
		           ha='center', fontsize=12, fontweight='bold',
		           color=color)
	
	# Draw interval brackets
	y_base = np.min(averaged_cycle) - (np.max(averaged_cycle) - np.min(averaged_cycle)) * 0.1
	txt_offset = -10
	
	if 'P' in features and 'R' in features:
		# PR interval
		ax.plot([features['P']['time_ms'], features['R']['time_ms']], 
		        [y_base, y_base], 'b-', linewidth=2)
		mid_pr = (features['P']['time_ms'] + features['R']['time_ms']) / 2
		txt = ax.text(mid_pr, y_base - txt_offset, f"PR: {intervals.get('PR_interval_ms', 0):.0f}ms",
		        ha='center', fontsize=10, color='blue')
		txt.set_path_effects([PathEffects.withStroke(linewidth=2, foreground='white')])
	
	if 'Q' in features and 'S' in features:
		# QRS duration
		y_base2 = y_base - 50
		ax.plot([features['Q']['time_ms'], features['S']['time_ms']], 
		        [y_base2, y_base2], 'g-', linewidth=2)
		mid_qrs = (features['Q']['time_ms'] + features['S']['time_ms']) / 2
		txt = ax.text(mid_qrs, y_base2 - txt_offset,
		    f"QRS: {intervals.get('QRS_duration_ms', 0):.0f}ms",
		    ha='center', fontsize=10, color='green')
		txt.set_path_effects([PathEffects.withStroke(linewidth=2, foreground='white')])
	
	if 'Q' in features and 'T' in features:
		# QT interval
		y_base3 = y_base - 100
		ax.plot([features['Q']['time_ms'], features['T']['time_ms']], 
		        [y_base3, y_base3], 'purple', linewidth=2)
		mid_qt = (features['Q']['time_ms'] + features['T']['time_ms']) / 2
		txt = ax.text(mid_qt, y_base3 - txt_offset, f"QT: {intervals.get('QT_interval_ms', 0):.0f}ms",
		        ha='center', fontsize=10, color='purple')
		txt.set_path_effects([PathEffects.withStroke(linewidth=2, foreground='white')])
	
	ax.axvline(x=0, color='red', linestyle='--', alpha=0.3)
	ax.set_xlabel('Time from R-peak (ms)', fontsize=12)
	ax.set_ylabel('Amplitude', fontsize=12)
	ax.set_title('ECG Analysis - Detected Features and Intervals', fontsize=14, fontweight='bold')
	ax.legend(loc='upper right')
	ax.grid(True, alpha=0.3)
	
	return fig

def print_analysis(features, intervals, total_cycles, good_cycles, rejection_reasons):
	"""
	Print educational analysis of the ECG.
	"""
	print("\n" + "="*70)
	print("ECG ANALYSIS RESULTS")
	print("="*70)
	
	# Cycle statistics
	print(f"\n📊 CYCLE STATISTICS:")
	print(f"   Total cycles detected: {total_cycles}")
	print(f"   Good quality cycles: {good_cycles} ({100*good_cycles/total_cycles:.1f}%)")
	print(f"   Rejected cycles: {total_cycles - good_cycles} ({100*(total_cycles-good_cycles)/total_cycles:.1f}%)")
	
	if len(rejection_reasons) > 0 and args.verbose:
		print(f"\n   Rejection reasons:")
		for idx, reasons in list(rejection_reasons.items())[:5]:  # Show first 5
			print(f"     Cycle {idx}: {', '.join(reasons)}")
		if len(rejection_reasons) > 5:
			print(f"     ... and {len(rejection_reasons)-5} more")
	
	# Heart rate
	if 'Heart_rate_bpm' in intervals:
		hr = intervals['Heart_rate_bpm']
		print(f"\n💓 HEART RATE: {hr:.1f} bpm")
		if hr < 60:
			print(f"   → Bradycardia (slow heart rate)")
		elif hr > 100:
			print(f"   → Tachycardia (fast heart rate)")
		else:
			print(f"   → Normal sinus rhythm")
	
	# Detected waves
	print(f"\n🌊 DETECTED WAVES:")
	wave_descriptions = {
		'P': 'Atrial depolarization (atria contract)',
		'Q': 'Start of ventricular depolarization',
		'R': 'Peak of ventricular depolarization (main heartbeat)',
		'S': 'End of ventricular depolarization',
		'T': 'Ventricular repolarization (ventricles reset)'
	}
	
	for wave in ['P', 'Q', 'R', 'S', 'T']:
		if wave in features:
			print(f"   {wave} wave: {features[wave]['time_ms']:+.1f}ms, amplitude={features[wave]['amplitude']:.1f}")
			print(f"      → {wave_descriptions[wave]}")
		else:
			print(f"   {wave} wave: Not detected")
	
	# Intervals
	print(f"\n📏 INTERVALS:")
	
	if 'PR_interval_ms' in intervals:
		pr = intervals['PR_interval_ms']
		print(f"   PR interval: {pr:.0f}ms")
		if pr < 120:
			print(f"      → Short (possible pre-excitation)")
		elif pr > 200:
			print(f"      → Prolonged (possible AV block)")
		else:
			print(f"      → Normal (120-200ms)")
		print(f"      → Time from atrial to ventricular activation")
	
	if 'QRS_duration_ms' in intervals:
		qrs = intervals['QRS_duration_ms']
		print(f"   QRS duration: {qrs:.0f}ms")
		if qrs < 80:
			print(f"      → Narrow (normal conduction)")
		elif qrs > 120:
			print(f"      → Wide (possible bundle branch block)")
		else:
			print(f"      → Normal (80-120ms)")
		print(f"      → Ventricular depolarization time")
	
	if 'QT_interval_ms' in intervals:
		qt = intervals['QT_interval_ms']
		qtc = intervals.get('QTc_ms', 0)
		print(f"   QT interval: {qt:.0f}ms (corrected: {qtc:.0f}ms)")
		if qtc > 450:
			print(f"      → Prolonged (risk of arrhythmia)")
		elif qtc < 350:
			print(f"      → Short")
		else:
			print(f"      → Normal (350-450ms)")
		print(f"      → Total ventricular activity time")
	
	print("\n" + "="*70)
	print("⚠️  NOTE: This is for educational purposes only.")
	print("    Consult a healthcare professional for medical interpretation.")
	print("="*70 + "\n")

def prepdata(millis=None, vals=None):
	#x = np.linspace(0.0, N*T, N, endpoint=False)
	data_start=0 # Picking a smaller window to examine
