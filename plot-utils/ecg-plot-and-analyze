	# Let's calculate the sampling rate based on the full data
	sam_per_sec = calc_sampling_rate(millis, time_units=1e-3)
	print(f"Calculated avg sampling rate: {sam_per_sec} Hz")
	
	# Parse data start time
	data_start_time = None
	
	# Try to get from filename first
	data_start_time = parse_start_time_from_filename(args.file)
	if data_start_time:
		print(f"Parsed start time from filename: {data_start_time.strftime('%H:%M:%S')}")
	
	# Override with --data-start-time if provided
	if args.data_start_time:
		data_start_time = parse_time_arg(args.data_start_time)
		print(f"Using provided start time: {data_start_time.strftime('%H:%M:%S')}")
	
	# Validate focus-time requirements
	if args.focus_time and not data_start_time:
		print("ERROR: --focus-time requires --data-start-time or a timestamp in the filename")
		print("  Filename should be in format: YYYY-MM-DD--HH:MM[AM|PM]")
		print("  Or provide --data-start-time HH:MM:SS")
		exit(1)
	
	# Calculate focus_time_s if focus_time is provided
	calculated_focus_time_s = None
	if args.focus_time and data_start_time:
		focus_time_obj = parse_time_arg(args.focus_time)
		data_start_seconds = time_to_seconds(data_start_time)
		focus_seconds = time_to_seconds(focus_time_obj)
		
		# Calculate seconds from start of recording
		calculated_focus_time_s = focus_seconds - data_start_seconds
		
		# Handle wrap-around (e.g., recording started at 23:00, focus at 01:00)
		if calculated_focus_time_s < 0:
			calculated_focus_time_s += 86400  # Add 24 hours
		
		print(f"Focus time: {focus_time_obj.strftime('%H:%M:%S')} ({calculated_focus_time_s:.1f}s from recording start)")
	
	ms=millis[data_start:data_end]
	vv=vals[data_start:data_end]
	#ms=millis
	#vv=vals
	ff = fft(vv)
	#ff[len(ff)//2+1] = 0
	# Our MCU code presently is trying to sample at 250Hz minimum, but I think I just found our Hz is actually reaching 1000Hz
	# but our calculated sampling rate ends up being less (248.x Hz)
	# freqs = fftfreq(vv.shape[0], 1/250)
	# Detect peaks
	# distance is somewhat arbitrary, but wider is probably better for
	# our use (finding the 60hz signal)
	freqs = fftfreq(vv.shape[0], 1/sam_per_sec)
	peak_distance = sam_per_sec/2
	peaks, peakprops = find_peaks(ff.real, distance=peak_distance)
	print("Peak count:", len(peaks))
	#ff[50:700] = 0
	#ff[0:2]=0
	reval = np.fft.ifft(ff)
	
	# Check if we should do averaging/analysis
	if args.avg or args.analyze:
		print("\n" + "="*70)
		print("PERFORMING CYCLE ANALYSIS")
		print("="*70)
		
		# Prepare filtered signal for R-peak detection
		vv_clean = vv - np.average(vv)
		vv_clean = butter_highpass_filter(vv_clean, 1, sam_per_sec, order=5)
		vv_clean = notch(vv_clean, 60, sam_per_sec, quality=10)
		
		# Detect R-peaks
		r_peaks = detect_r_peaks(vv_clean, sam_per_sec)
		print(f"Detected {len(r_peaks)} R-peaks (heartbeats)")
		
		if len(r_peaks) < 2:
			print("⚠️  Not enough heartbeats detected for analysis!")
		else:
			# Extract cycles
			cycles, cycle_times, cycle_indices = extract_cycles(vv_clean, ms, r_peaks, sam_per_sec)
			print(f"Extracted {len(cycles)} complete cycles")
			
			# Reject artifacts
			good_indices, rejection_reasons = reject_artifacts(cycles, cycle_times, r_peaks, ms, sam_per_sec)
			print(f"Quality control: {len(good_indices)} good cycles, {len(rejection_reasons)} rejected")
			
			if len(good_indices) < 1:
				print("⚠️  No good quality cycles after artifact rejection!")
			else:
				# Calculate cycle duration statistics
				if len(r_peaks) > 1:
					rr_intervals = []
					for i in range(len(r_peaks) - 1):
						rr = ms[r_peaks[i+1]] - ms[r_peaks[i]]
						rr_intervals.append(rr)
					rr_intervals = np.array(rr_intervals)
					
					print(f"\n📊 RR Interval Statistics:")
					print(f"   Mean: {np.mean(rr_intervals):.1f}ms (HR: {60000/np.mean(rr_intervals):.1f} bpm)")
					print(f"   Std Dev: {np.std(rr_intervals):.1f}ms")
					print(f"   Range: {np.min(rr_intervals):.1f} - {np.max(rr_intervals):.1f}ms")
					print(f"   Coefficient of Variation: {100*np.std(rr_intervals)/np.mean(rr_intervals):.1f}%")
				
				# Average good cycles
				good_cycles = [cycles[i] for i in good_indices]
				good_cycle_times = [cycle_times[i] for i in good_indices]
				r_peak_times_ms = ms[r_peaks][np.array(good_indices)]
				
				# Use CLI arguments for focus and max_cycles
				averaged_cycle, averaged_time, selected_indices, resampled_cycles, resampled_time = average_cycles(
					good_cycles, good_cycle_times, r_peak_times_ms,
