				                    plot_resampled=not args.no_avg_plot_resampled)
				
				# If analyze flag, do full feature detection
				if args.analyze:
					print("\n" + "="*70)
					print("DETECTING ECG FEATURES")
					print("="*70)
					
					features = detect_pqrst_features(averaged_cycle, averaged_time, sam_per_sec)
					
					# Calculate intervals
					avg_rr = np.mean(rr_intervals) if len(r_peaks) > 1 else None
					intervals = calculate_intervals(features, avg_rr)
					
					# Print analysis
